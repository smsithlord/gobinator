// gobinator.exe's resources: its icon (media/source/build.py makes it; Explorer also shows it on .gob files that open
// with Gobinator), the packaged gobinator.ini (written beside the EXE when there is none: src/firstrun.cpp), and its
// version, shown in the file's Properties > Details (src/version.h).
#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_GOBINATOR ICON "../media/gobinator.ico"
IDR_PACKAGED_INI RCDATA "../package/gobinator.ini"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GOBINATOR_VERSION_MAJOR,GOBINATOR_VERSION_MINOR,GOBINATOR_VERSION_PATCH,GOBINATOR_VERSION_BUILD
PRODUCTVERSION GOBINATOR_VERSION_MAJOR,GOBINATOR_VERSION_MINOR,GOBINATOR_VERSION_PATCH,GOBINATOR_VERSION_BUILD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if GOBINATOR_VERSION_BUILD
FILEFLAGS VS_FF_PRERELEASE
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "SM Sith Lord"
			VALUE "FileDescription", "Gobinator: double-click a Jedi Knight episode to play it"
			VALUE "FileVersion", GOBINATOR_VERSION_TEXT
			VALUE "InternalName", "gobinator"
			VALUE "LegalCopyright", "CC0 1.0 Universal: public domain, no rights reserved"
			VALUE "OriginalFilename", "gobinator.exe"
			VALUE "ProductName", "Gobinator"
			VALUE "ProductVersion", GOBINATOR_VERSION_TEXT
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
